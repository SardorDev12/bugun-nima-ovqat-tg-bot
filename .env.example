# Telegram bot token from @BotFather
BOT_TOKEN=

# Postgres connection string (Neon free tier)
DATABASE_URL=

# Random secret used as part of the webhook URL path, e.g. openssl rand -hex 24
WEBHOOK_SECRET=

# Public HTTPS URL of this deployment (Fly.io app URL). Used to register the
# Telegram webhook on startup. Leave empty to skip auto-registration (e.g. in
# local dev where you're not exposing a public URL).
PUBLIC_URL=

PORT=8080

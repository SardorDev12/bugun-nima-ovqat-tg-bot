# Telegram bot token from @BotFather
BOT_TOKEN=

# Postgres connection string (Neon free tier)
DATABASE_URL=

# Random secret used as part of the webhook URL path, e.g. openssl rand -hex 24
WEBHOOK_SECRET=

# Public HTTPS URL of the deployed Worker, e.g. https://nima-ovqat-bot.<your-subdomain>.workers.dev
# Only needed to run `npm run setup:webhook` (registers the Telegram webhook).
PUBLIC_URL=
